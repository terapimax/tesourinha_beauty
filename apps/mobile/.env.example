# Copie para .env e preencha com os dados do seu projeto Supabase (Project Settings > API).
# Sem estas variáveis o app roda em modo demonstração, com dados locais.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "anon" (pública). NUNCA coloque a service_role aqui.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
